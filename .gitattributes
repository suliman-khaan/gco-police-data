# Normalise line endings to LF in the repo (WordPress standard; shell hooks need LF)
* text=auto eol=lf

# Binary files
*.xlsx binary
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary

# Keep repo meta files out of `git archive` release zips
.gitignore     export-ignore
.gitattributes export-ignore
