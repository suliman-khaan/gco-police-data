{
	"name": "gco/police-data",
	"description": "GCO Police Data WordPress plugin (dev tooling only; the plugin has no runtime dependencies).",
	"type": "wordpress-plugin",
	"license": "proprietary",
	"authors": [
		{
			"name": "Suliman K.",
			"homepage": "https://sulimankhan.pro"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"fix": "phpcbf",
		"test": "phpunit"
	}
}
